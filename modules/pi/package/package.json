{
  "name": "nixdots-pi-extensions",
  "version": "1.0.0",
  "description": "Pi extensions for nixdots config",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "dependencies": {
    "@ff-labs/fff-node": "^0.11.0",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/apply-patch/src/index.ts",
      "./extensions/ask.ts",
      "./extensions/fff-attach.ts",
      "./extensions/pi-notify.ts",
      "./extensions/session-age.ts",
      "./extensions/session-title.ts",
      "./extensions/handoff.ts"
    ]
  }
}
